#!/usr/bin/env python3
"""Tilovaný prehľad okien — náhrada hyprexpo bez pluginov.

Prvé volanie presunie všetky okná z normálnych pracovných plôch na špeciálnu
plochu "exposed" a rozloží ich do mriežky. Druhé volanie ich vráti späť na
pôvodné plochy vrátane floating geometrie a fullscreenu a fokus dostane to
okno, ktoré bolo aktívne pred prehľadom.

Kým je prehľad otvorený, drží hyprland.lua submap "overview" s bindom na
ľavé tlačidlo: klik vyberie okno pod kurzorom (`--pointer`). Bez toho by klik
na už fokusovanú dlaždicu nespravil nič — fokus sa nemení, takže žiadny event
nepríde. Okná, ktoré sa pod veľkosť bunky nedajú zmenšiť (Telegram a iné
appky s vlastnou minimálnou veľkosťou), dostanú vlastný stĺpec po pravej
strane, aby neprekrývali susedné dlaždice.

Stav sa drží v $XDG_STATE_HOME/window-overview/state.json — bez neho by sa
okná nedali vrátiť tam, odkiaľ prišli.

Hyprland v HyDE beží na Lua configu, takže starý zápis
`hyprctl dispatch movetoworkspace ...` skončí chybou parsovania. Dispatchere
sa preto volajú ako Lua výrazy: `hyprctl dispatch 'hl.dsp.window.move({...})'`.
"""

from __future__ import annotations

import fcntl
import json
import math
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "window-overview"
STATE = STATE_DIR / "state.json"
LOCK = STATE_DIR / "lock"
GAP = 12      # medzera medzi dlaždicami
EDGE = 16     # okraj od hrany monitora
SPECIAL = "exposed"
SUBMAP = "overview"  # mód, v ktorom klik vyberá dlaždicu (hyprland.lua)


def debug(*args) -> None:
    if os.environ.get("OVERVIEW_DEBUG"):
        print("[overview]", *args, file=sys.stderr, flush=True)


def hyprctl(*args: str) -> str:
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def hypr_json(name: str):
    out = hyprctl("-j", name).strip()
    return json.loads(out) if out else None


def clients():
    return hypr_json("clients") or []


def dispatch(expr: str) -> None:
    hyprctl("dispatch", expr)


def window(addr: str) -> str:
    return f'hl.get_window("address:{addr}")'


def move_to_workspace(addr: str, workspace) -> None:
    dispatch(f"hl.dsp.window.move({{ window = {window(addr)}, workspace = {json.dumps(workspace)}, follow = false }})")


def set_floating(addr: str, floating: bool) -> None:
    action = "set" if floating else "unset"
    dispatch(f'hl.dsp.window.float({{ window = {window(addr)}, action = "{action}" }})')


def move_pixel(addr: str, x: int, y: int) -> None:
    dispatch(f"hl.dsp.window.move({{ window = {window(addr)}, x = {x}, y = {y}, exact = true }})")


def resize_pixel(addr: str, width: int, height: int) -> None:
    dispatch(f"hl.dsp.window.resize({{ window = {window(addr)}, x = {width}, y = {height}, exact = true }})")


def focus(addr: str) -> None:
    dispatch(f"hl.dsp.focus({{ window = {window(addr)} }})")


def fullscreen_state(addr: str, state: int) -> None:
    dispatch(
        f"hl.dsp.window.fullscreen_state({{ window = {window(addr)}, internal = {state}, client = {state} }})"
    )


def swap_windows(addr: str, other: str) -> None:
    dispatch(f"hl.dsp.window.swap({{ window = {window(addr)}, target = {window(other)} }})")


def toggle_special() -> None:
    dispatch(f'hl.dsp.workspace.toggle_special("{SPECIAL}")')


def special_visible() -> bool:
    for monitor in hypr_json("monitors") or []:
        if monitor.get("focused") and monitor["specialWorkspace"]["name"]:
            return True
    return False


def area(client: dict) -> int:
    return client["size"][0] * client["size"][1]


def submap_available() -> bool:
    """Submap `overview` definuje hyprland.lua. Do neexistujúceho modu by sme
    vojsť nemali — klávesnica by v ňom prestala reagovať."""
    return any(bind.get("submap") == SUBMAP for bind in hypr_json("binds") or [])


def enter_submap() -> None:
    if submap_available():
        dispatch(f'hl.dsp.submap("{SUBMAP}")')


def leave_submap() -> None:
    dispatch('hl.dsp.submap("reset")')


def window_at_pointer(addresses: set[str]) -> str | None:
    """Vráti dlaždicu pod kurzorom (vrchnú, keď sa prekrývajú)."""
    point = hypr_json("cursorpos") or {}
    x, y = point.get("x"), point.get("y")
    if x is None or y is None:
        return None
    hits = [
        c
        for c in clients()
        if c["address"] in addresses
        and c["at"][0] <= x < c["at"][0] + c["size"][0]
        and c["at"][1] <= y < c["at"][1] + c["size"][1]
    ]
    if not hits:
        return None
    hits.sort(key=lambda c: c.get("focusHistoryID", 0))  # 0 = navrchu
    return hits[0]["address"]


def place_grid(addresses: list[str], x: int, y: int, width: int, height: int):
    """Rozloží adresy do mriežky v zadanom obdĺžniku.

    Počet stĺpcov sa drží pomeru strán, takže dlaždice zostanú skoro štvorcové
    (na 16:9 tak vyjdú 2 stĺpce pre 1-4 okná). Vráti pozície a veľkosť bunky.
    """
    count = max(len(addresses), 1)
    cols = max(1, min(count, round(math.sqrt(count * width / max(height, 1)))))
    rows = math.ceil(count / cols)
    cell_w = (width - GAP * (cols - 1)) // cols
    cell_h = (height - GAP * (rows - 1)) // rows
    positions = {}
    for index, addr in enumerate(addresses):
        column, row = index % cols, index // cols
        positions[addr] = (x + column * (cell_w + GAP), y + row * (cell_h + GAP))
    return positions, cell_w, cell_h


def fit_in_cells(cells: dict[str, tuple[int, int]], cell_w: int, cell_h: int) -> None:
    """Druhý prechod: niektoré okná (Telegram, Electron appky) si po presune na
    inú plochu ešte raz nastavia vlastnú geometriu. Tie sa dorovnajú na bunku
    a vycentrujú, aby neprečnievali len na jednu stranu."""
    for c in clients():
        addr = c["address"]
        if addr not in cells:
            continue
        x, y = cells[addr]
        if c["size"] != [cell_w, cell_h]:
            resize_pixel(addr, cell_w, cell_h)
            c = next((live for live in clients() if live["address"] == addr), c)
            x += max(0, (cell_w - c["size"][0]) // 2)
            y += max(0, (cell_h - c["size"][1]) // 2)
        move_pixel(addr, x, y)


def load_state():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return None


def save_state(state: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=1))


class InstanceLock:
    """Listener v hyprland.lua môže skript spustiť viackrát za sebou; druhý
    beh by prepísal stav a okná by zostali rozhádzané."""

    def __enter__(self) -> bool:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self.handle = LOCK.open("w")
        try:
            fcntl.flock(self.handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            self.handle.close()
            self.handle = None
            return False
        return True

    def __exit__(self, *_) -> None:
        # __exit__ sa volá aj vtedy, keď __enter__ vrátil False (zamknuté
        # iným behom) — vtedy už je handle zavretý.
        if self.handle is None:
            return
        fcntl.flock(self.handle, fcntl.LOCK_UN)
        self.handle.close()


def restore_panes(workspace_id: int, desired: list[dict], alive: set[str]) -> None:
    """Vráti okná do pôvodných panelov.

    Dwindle pri presune okien späť rozloženie poskladá znovu, takže veľký
    panel skončí pri inom okne. Veľkosť panelu je pritom daná stromom, nie
    oknom — preto stačí okná poprehadzovať (`swap`), kým každé nesedí na
    paneli s rovnakou veľkosťou, akú malo pred prehľadom.
    """
    targets = sorted(
        (e for e in desired if e["workspace_id"] == workspace_id and not e["floating"] and e["address"] in alive),
        key=lambda e: (-(e["size"][0] * e["size"][1]), e["at"][1], e["at"][0]),
    )
    for index, target in enumerate(targets):
        live = sorted(
            (c for c in clients() if c["workspace"]["id"] == workspace_id and not c["floating"]),
            key=lambda c: (-area(c), c["at"][1], c["at"][0]),
        )
        if index >= len(live) or live[index]["address"] == target["address"]:
            continue
        swap_windows(target["address"], live[index]["address"])


def close(state: dict, select: bool = False, selected: str | None = None) -> None:
    alive = {c["address"] for c in clients()}
    entries = state.get("windows") or []
    if any("size" not in entry for entry in entries):
        STATE.unlink(missing_ok=True)
        leave_submap()
        return  # stav z inej verzie skriptu — radšej nič neposúvať

    # Kliknutie na dlaždicu = fokus na to okno. Použijeme ho ako cieľ namiesto
    # okna, ktoré bolo aktívne pred prehľadom.
    addresses = {entry["address"] for entry in entries}
    clicked = None
    if selected and selected in addresses:
        clicked = selected
    elif select and (active := (hypr_json("activewindow") or {})).get("address") in addresses:
        clicked = active["address"]

    # Príznak pre listener v hyprland.lua: fokusovanie okien pri návrate
    # nesmie spustiť ďalšie zatváranie.
    save_state(dict(state, closing=True))

    # Dwindle delí panel podľa toho, kde je kurzor, takže rovnaké poradie
    # presunov raz vyjde zrkadlovo prevrátené. Kurzor preto počas obnovy
    # pripneme do ľavého horného rohu a okná vraciame zľava doprava, zhora
    # dolu — rozloženie tak vychádza stále rovnako.
    monitors = hypr_json("monitors") or []
    monitor = next((m for m in monitors if m.get("focused")), monitors[0] if monitors else None)
    if monitor:
        dispatch(f'hl.dsp.cursor.move({{ x = {monitor["x"] + 2}, y = {monitor["y"] + 2} }})')

    for entry in sorted(entries, key=lambda e: (e["workspace_id"], e["at"][1], e["at"][0])):
        addr = entry["address"]
        if addr not in alive:
            continue  # okno medzitým zavreli
        move_to_workspace(addr, entry["workspace_id"])
        focus(addr)
        set_floating(addr, entry["floating"])
        if entry["floating"]:
            resize_pixel(addr, *entry["size"])
            move_pixel(addr, *entry["at"])

    time.sleep(0.3)

    for workspace_id in {entry["workspace_id"] for entry in entries}:
        restore_panes(workspace_id, entries, alive)

    for entry in entries:
        if entry["fullscreen"] and entry["address"] in alive:
            focus(entry["address"])
            fullscreen_state(entry["address"], entry["fullscreen"])

    if special_visible():
        toggle_special()
    target = clicked or state.get("focused")
    debug("clicked:", clicked, "| nahlaseny fokus:", state.get("focused"), "| ciel:", target)
    if target in alive:
        focus(target)
    STATE.unlink(missing_ok=True)
    leave_submap()


def open_overview(windows: list[dict]) -> None:
    monitors = hypr_json("monitors") or []
    monitor = next((m for m in monitors if m.get("focused")), monitors[0] if monitors else None)
    # `hyprctl clients` v tomto Hyprlande pole "focused" nemá — bez tohto by sa
    # po zavretí prehľadu fokus nevrátil oknu, ktoré bolo aktívne pred ním.
    focused = (hypr_json("activewindow") or {}).get("address")

    # Príznak "busy" drží listener v hyprland.lua ticho, kým presúvame okná —
    # inak by fokus z prvého presunu hneď prehľad zavrel.
    state = {
        "focused": focused if focused in {c["address"] for c in windows} else None,
        "windows": [
            {
                "address": c["address"],
                "workspace_id": c["workspace"]["id"],
                "at": c["at"],
                "size": c["size"],
                "floating": bool(c["floating"]),
                "fullscreen": c.get("fullscreen", 0),
            }
            for c in windows
        ],
    }
    save_state(dict(state, busy=True))

    for c in windows:
        move_to_workspace(c["address"], f"special:{SPECIAL}")
    if not special_visible():
        toggle_special()

    width, height = (monitor["width"], monitor["height"]) if monitor else (1920, 1080)
    origin_x, origin_y = (monitor["x"], monitor["y"]) if monitor else (0, 0)
    area_x, area_y = origin_x + EDGE, origin_y + EDGE
    area_w, area_h = width - EDGE * 2, height - EDGE * 2
    ordered = [c["address"] for c in sorted(windows, key=lambda c: (c["workspace"]["id"], c["at"][1], c["at"][0]))]

    cells, cell_w, cell_h = place_grid(ordered, area_x, area_y, area_w, area_h)
    for addr in ordered:
        set_floating(addr, True)
        resize_pixel(addr, cell_w, cell_h)
        move_pixel(addr, *cells[addr])

    time.sleep(0.25)
    fit_in_cells(cells, cell_w, cell_h)

    # Okná, ktoré majú vlastnú minimálnu veľkosť (Telegram), sa pod bunku
    # nezmenšia. Keď v bunke zostanú väčšie, prekrývajú susedné dlaždice a berú
    # im kliknutia — preto dostanú vlastný stĺpec po pravej strane a ostatné sa
    # poskladajú do zvyšku obrazovky.
    sizes = {c["address"]: c["size"] for c in clients()}
    oversized = [
        addr
        for addr in ordered
        if sizes.get(addr, [0, 0])[0] > cell_w + 2 or sizes.get(addr, [0, 0])[1] > cell_h + 2
    ]
    rest = [addr for addr in ordered if addr not in oversized]
    if oversized and rest:
        # Stĺpec dostane najviac polovicu obrazovky, ale keď je okno širšie,
        # necháme mu toľko, koľko potrebuje — so 320 px pre ostatné dlaždice.
        cap = max(area_w // 2, area_w - GAP - 320)
        big_w = min(max(sizes[addr][0] for addr in oversized), cap)
        rest_w = area_w - big_w - GAP
        if rest_w >= 4 * EDGE:
            cells, cell_w, cell_h = place_grid(rest, area_x, area_y, rest_w, area_h)
            for addr in rest:
                resize_pixel(addr, cell_w, cell_h)
                move_pixel(addr, *cells[addr])
            column_x, offset = area_x + rest_w + GAP, area_y
            for addr in oversized:
                cells[addr] = (column_x, offset)
                move_pixel(addr, column_x, offset)
                offset += sizes[addr][1] + GAP
            time.sleep(0.25)
            fit_in_cells(cells, cell_w, cell_h)

    save_state(state)  # prehľad je hotový, klik na dlaždicu už smie zavrieť
    enter_submap()  # klik vyberie dlaždicu pod kurzorom
    start_click_watcher()


def socket_path() -> Path:
    return Path(
        os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    ) / "hypr" / os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "") / ".socket2.sock"


def start_click_watcher() -> None:
    """Pustí sa na pozadí a zavrie prehľad, keď používateľ klikne na dlaždicu."""
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--watch"],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def watch_for_click() -> int:
    """Čaká na fokus z kliknutia na dlaždicu a prehľad zavrie s tým oknom.

    Kliknutie na dlaždicu je bežný fokus okna na špeciálnej ploche, takže sa
    nedá rozlíšiť od fokusu, ktorý si pri otváraní spôsobí skript sám — preto
    watcher štartuje až po otvorení, chvíľu mlčí a reaguje len na fokus okna,
    ktoré je na `special:exposed`.
    """
    time.sleep(0.8)  # doznenie presunov z otvárania
    while STATE.exists():
        state = load_state() or {}
        if state.get("closing") or state.get("busy"):
            time.sleep(0.3)
            continue
        try:
            connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            connection.connect(str(socket_path()))
        except OSError:
            time.sleep(0.5)
            continue
        with connection:
            connection.settimeout(0.5)
            while STATE.exists():
                try:
                    data = connection.recv(4096)
                except socket.timeout:
                    continue
                except OSError:
                    break
                if not data:
                    break
                if b"activewindow" not in data:
                    continue
                time.sleep(0.2)  # nech sa fokus dokončí
                active = hypr_json("activewindow") or {}
                if active.get("workspace", {}).get("id", 0) < 0 and STATE.exists():
                    subprocess.run(
                        [sys.executable, os.path.abspath(__file__), "--select=" + active.get("address", "")],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                    )
                    return 0
    return 0


def main() -> int:
    arguments = sys.argv[1:]
    if "--watch" in arguments:
        return watch_for_click()

    select = any(arg.startswith("--select") for arg in arguments)
    selected = next((arg.split("=", 1)[1] for arg in arguments if arg.startswith("--select=")), None)
    pointer = "--pointer" in arguments  # bind ľavého tlačidla v submape
    cancel = "--cancel" in arguments  # ESC v submape
    with InstanceLock() as acquired:
        if not acquired:
            return 0  # iné volanie práve beží

        state = load_state()
        if state:
            if cancel:
                close(state)  # zavrie prehľad a nechá fokus tak, ako bol
            elif pointer:
                addresses = {entry["address"] for entry in state.get("windows") or []}
                close(state, selected=window_at_pointer(addresses))
            else:
                close(state, select=select, selected=selected)
            return 0

        leave_submap()  # po prehľade nesmie zostať mód, v ktorom klávesnica mlčí
        if pointer or cancel:
            return 0  # klik alebo ESC mimo prehľadu nemá čo robiť

        windows = [c for c in clients() if c["workspace"]["id"] > 0]  # bez skrytých scratchpadov
        if not windows:
            subprocess.run(["notify-send", "-a", "overview", "Prehľad okien", "Na plochách nie sú žiadne okná"])
            return 0

        open_overview(windows)
        return 0


if __name__ == "__main__":
    sys.exit(main())
